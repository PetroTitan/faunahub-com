{
  "name": "faunahub-com",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-search-index.mjs && node scripts/generate-finder-index.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.ts\"",
    "search:index": "node scripts/generate-search-index.mjs",
    "search:check": "node scripts/generate-search-index.mjs --check",
    "finder:index": "node scripts/generate-finder-index.mjs",
    "finder:check": "node scripts/generate-finder-index.mjs --check",
    "finder:audit": "node scripts/generate-finder-index.mjs --audit"
  },
  "dependencies": {
    "next": "^15.5.18",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
